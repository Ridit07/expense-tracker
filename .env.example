# Copy to .env for local development.

# Postgres connection strings (read/write split; point both at the same DB locally)
DB_READ_URL=postgres://expense:expense@localhost:5432/expense_tracker?sslmode=disable
DB_WRITE_URL=postgres://expense:expense@localhost:5432/expense_tracker?sslmode=disable

# HTTP server
HTTP_PORT=8080

# Secret used to sign JWT access tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# local | production
ENV=local
LOG_LEVEL=info
